prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/../include

Name: libssh
Description: The SSH Library
Version: 0.12.2
Libs: "-L${libdir}" -lssh
Cflags: "-I${includedir}"
Requires.private:  libcrypto
Libs.private:  -pthread -liphlpapi -lws2_32 -lshell32 -ladvapi32

