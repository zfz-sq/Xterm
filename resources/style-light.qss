/* Xterm 亮色主题 —— 与深色版同一结构，仅换色板 */

* {
    color: #24292E;
    selection-background-color: #CDE8FF;
    selection-color: #1F1F1F;
}

QMainWindow, QWidget#centralwidget {
    background-color: #F3F3F3;
}

/* ---------------- 面板容器 ---------------- */

QFrame#connectionBar, QFrame#advancedBar, QFrame#terminalPanel {
    background-color: #FFFFFF;
    border: 1px solid #DCDCDE;
    border-radius: 6px;
}

QLabel {
    background: transparent;
    color: #5A5A5E;
}

/* ---------------- 输入类控件 ---------------- */

QComboBox, QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #C9C9CD;
    border-radius: 4px;
    padding: 3px 8px;
    min-height: 20px;
}
QComboBox:hover, QLineEdit:hover {
    background-color: #F6F6F8;
    border-color: #AFAFB5;
}
QComboBox:focus, QLineEdit:focus {
    border-color: #007ACC;
    background-color: #FFFFFF;
}
QComboBox:disabled, QLineEdit:disabled {
    color: #9A9A9E;
    background-color: #F0F0F2;
    border-color: #DCDCDE;
}
QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: center right;
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    image: url(:/icons/light/down.png);
    width: 12px;
    height: 12px;
}
/* 字号等数字输入：与 QLineEdit 同款（浅色主题保持一致观感） */
QSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #C9C9CD;
    border-radius: 4px;
    padding: 3px 8px;
    min-height: 20px;
}
QSpinBox:hover {
    background-color: #F6F6F8;
    border-color: #AFAFB5;
}
QSpinBox:focus {
    border-color: #007ACC;
}
QSpinBox:disabled {
    color: #9A9A9E;
    background-color: #F0F0F2;
    border-color: #DCDCDE;
}
QSpinBox::up-button, QSpinBox::down-button {
    subcontrol-origin: border;
    border: none;
    width: 20px;
    background-color: transparent;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #F6F6F8;
}
QSpinBox::up-arrow {
    image: url(:/icons/light/up.png);
    width: 12px;
    height: 12px;
}
QSpinBox::down-arrow {
    image: url(:/icons/light/down.png);
    width: 12px;
    height: 12px;
}
QComboBox#baudCombo {
    min-height: 30px;
    max-height: 30px;
    padding: 0 2px 0 8px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-right: none;
}
QToolButton#settingsBtn {
    background-color: #FFFFFF;
    border: 1px solid #C9C9CD;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    padding: 0;
    margin: 0;
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
}
QToolButton#settingsBtn:hover {
    background-color: #F6F6F8;
    border-color: #AFAFB5;
}
QToolButton#settingsBtn:pressed {
    background-color: #E8E8EC;
}

QLineEdit#passwordEdit {
    min-height: 30px;
    max-height: 30px;
    padding: 0 8px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-right: none;
}
QToolButton#pwToggleBtn {
    background-color: #FFFFFF;
    border: 1px solid #C9C9CD;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    padding: 0;
    margin: 0;
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
}
QToolButton#pwToggleBtn:hover {
    background-color: #F6F6F8;
    border-color: #AFAFB5;
}
QToolButton#pwToggleBtn:pressed {
    background-color: #E8E8EC;
}
QComboBox {
    combobox-popup: 0;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #1F1F1F;
    border: 1px solid #C9C9CD;
    selection-background-color: #D6E9FF;
    selection-color: #1F1F1F;
    outline: none;
}
QComboBox QLineEdit {
    background: transparent;
    border: none;
    padding: 0;
    min-height: 0;
}
QComboBox#sshPortCombo {
    padding: 0;
}
QComboBox#sshPortCombo QLineEdit {
    padding: 0 0 0 8px;
    margin: 0;
}
QComboBox#sshPortCombo::drop-down {
    subcontrol-origin: border;
    subcontrol-position: center right;
    width: 16px;
    border: none;
}

/* ---------------- 多行文本（MCP 提示词 / 命令输出） ---------------- */

QPlainTextEdit, QTextEdit, QTextBrowser {
    background-color: #FBFBFC;
    color: #24292E;
    border: 1px solid #DCDCDE;
    border-radius: 4px;
    selection-background-color: #D6E9FF;
    selection-color: #1F1F1F;
}
QPlainTextEdit:focus, QTextEdit:focus, QTextBrowser:focus {
    border-color: #007ACC;
}

/* ---------------- 按钮 ---------------- */

QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #C9C9CD;
    border-radius: 4px;
    padding: 5px 14px;
    min-height: 18px;
}
QPushButton:hover {
    background-color: #F0F0F3;
    border-color: #A8A8AE;
}
QPushButton:pressed {
    background-color: #E8E8EC;
}
QPushButton:disabled {
    color: #9A9A9E;
    background-color: #F2F2F4;
    border-color: #DCDCDE;
}

QPushButton#connectBtn {
    background-color: #2EA043;
    border: 1px solid #2C9A40;
    color: #FFFFFF;
    font-weight: 600;
}
QPushButton#connectBtn:hover {
    background-color: #33B349;
    border-color: #36B84D;
}
QPushButton#connectBtn:pressed {
    background-color: #28913C;
}
QPushButton#connectBtn:disabled {
    background-color: #B9D8C0;
    border-color: #B9D8C0;
    color: #F0F6F1;
}

QPushButton#connectBtn[connected="true"] {
    background-color: transparent;
    border: 1px solid #E0A2A2;
    color: #D0453B;
}
QPushButton#connectBtn[connected="true"]:hover {
    background-color: #FBEDED;
    border-color: #E07B7B;
}
QPushButton#connectBtn[connected="true"]:pressed {
    background-color: #F5E2E2;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 3px;
}
QToolButton:hover {
    background-color: #ECECEF;
    border-color: #C9C9CD;
}
QToolButton:pressed {
    background-color: #E2E2E6;
}
QToolButton:checked {
    background-color: #CDE4FB;
    border-color: #7FB6E8;
}
QToolButton:disabled {
    color: #B0B0B4;
}

QToolButton#paneTool {
    background-color: #FFFFFF;
    border: 1px solid #C9C9CD;
    border-radius: 4px;
    padding: 2px 6px;
    color: #1F1F1F;
}
QToolButton#paneTool:hover {
    background-color: #F0F0F3;
    border-color: #A8A8AE;
}
QToolButton#paneTool:pressed {
    background-color: #E8E8EC;
}
QToolButton#paneTool:disabled {
    color: #9A9A9E;
    background-color: #F2F2F4;
    border-color: #DCDCDE;
}

QFrame#pathBar {
    background-color: #FFFFFF;
    border: 1px solid #C9C9CD;
    border-radius: 4px;
}
QFrame#pathBar QScrollArea, QFrame#pathBar QWidget#pathCrumbs {
    background: transparent;
    border: none;
}
QFrame#pathBar QLineEdit#pathEdit {
    border: none;
    background: transparent;
    min-height: 0;
    padding: 0 6px;
}
QToolButton#pathCrumb, QToolButton#pathEditBtn {
    background: transparent;
    border: none;
    border-radius: 3px;
    padding: 1px 4px;
    color: #1F1F1F;
}
QToolButton#pathCrumb {
    padding: 1px 0px;
}
QToolButton#pathCrumb:hover, QToolButton#pathEditBtn:hover {
    background-color: #E8E8EC;
}
QLabel#pathSep {
    color: #8A8A90;
    padding: 0 1px;
    background: transparent;
}

/* 模式切换：当前在哪个终端的主入口，带文字，做出实体按钮感 */
QToolButton#modeBtn, QToolButton#mcpBtn {
    background-color: #FFFFFF;
    border: 1px solid #C9C9CD;
    border-radius: 4px;
    padding: 4px 8px;
    font-weight: 600;
}
QToolButton#modeBtn:hover, QToolButton#mcpBtn:hover {
    background-color: #F0F0F3;
    border-color: #A8A8AE;
}
QToolButton#modeBtn:pressed, QToolButton#mcpBtn:pressed {
    background-color: #E8E8EC;
}

/* 私钥浏览：与 QLineEdit 同一口径，读作输入框的附属按钮 */
QToolButton#keyBrowseBtn {
    background-color: #FFFFFF;
    border: 1px solid #C9C9CD;
    border-radius: 4px;
    padding: 0;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
}
QToolButton#keyBrowseBtn:hover {
    background-color: #F0F0F3;
    border-color: #A8A8AE;
}
QToolButton#keyBrowseBtn:pressed {
    background-color: #E8E8EC;
}
QToolButton#keyBrowseBtn:disabled {
    background-color: #F2F2F4;
    border-color: #DCDCDE;
    color: #B0B0B4;
}

/* 模式页容器：让面板底色透出来，切页时不出现色块 */
QStackedWidget {
    background: transparent;
    border: none;
}

/* ---------------- 列表 ---------------- */

QListWidget {
    background-color: #FBFBFC;
    alternate-background-color: #F3F3F5;
    border: 1px solid #DCDCDE;
    border-radius: 4px;
    outline: none;
}
QListWidget::item {
    padding: 2px;
    border-radius: 3px;
}
QListWidget::item:hover {
    background-color: #F0F0F3;
}
QListWidget::item:selected {
    background-color: #D6E9FF;
    color: #1F1F1F;
}

/* ---------------- 对话框与树/表格（文件管理器 / 传输队列 / 消息框） ---------------- */

QDialog {
    background-color: #F3F3F3;
}

QTreeWidget, QTreeView, QTableWidget, QTableView {
    background-color: #FBFBFC;
    alternate-background-color: #F3F3F5;
    border: 1px solid #DCDCDE;
    border-radius: 4px;
    outline: none;
    gridline-color: #E8E8EA;
}
QTreeView::item, QTreeWidget::item, QTableView::item, QTableWidget::item {
    padding: 2px 1px;
    border-radius: 2px;
}
QTreeView::item:hover, QTreeWidget::item:hover,
QTableView::item:hover, QTableWidget::item:hover {
    background-color: #F0F0F3;
}
QTreeView::item:selected, QTreeWidget::item:selected,
QTableView::item:selected, QTableWidget::item:selected {
    background-color: #D6E9FF;
    color: #1F1F1F;
}
QTreeView::branch {
    background-color: transparent;
}

QHeaderView::section {
    background-color: #EDEDEF;
    color: #3C4045;
    border: none;
    border-right: 1px solid #DCDCDE;
    border-bottom: 1px solid #DCDCDE;
    padding: 4px 8px;
}
QTableCornerButton::section {
    background-color: #EDEDEF;
    border: none;
}

QProgressBar {
    background-color: #FFFFFF;
    border: 1px solid #C9C9CD;
    border-radius: 4px;
    color: #24292E;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #007ACC;
    border-radius: 3px;
}

QSplitter::handle {
    background-color: #DCDCDE;
}
QSplitter::handle:hover {
    background-color: #007ACC;
}

/* ---------------- 滚动区与滚动条 ---------------- */

QScrollArea {
    background: transparent;
    border: none;
}
QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #C6C6CB;
    border-radius: 4px;
    min-height: 28px;
}
QScrollBar::handle:vertical:hover {
    background: #A9A9B0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #C6C6CB;
    border-radius: 4px;
    min-width: 28px;
}
QScrollBar::handle:horizontal:hover {
    background: #A9A9B0;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ---------------- 状态栏 ---------------- */

QStatusBar {
    background-color: #F3F3F3;
    border-top: 1px solid #007ACC;
    color: #6A6A6E;
}
QStatusBar QLabel {
    color: #6A6A6E;
    padding: 0 2px;
}

/* ---------------- 提示气泡 ---------------- */

QToolTip {
    background-color: #FFFFFF;
    color: #24292E;
    border: 1px solid #C9C9CD;
    padding: 5px 8px;
    border-radius: 3px;
}

/* ---------------- 自定义标题栏（无边框窗口，VSCode 式工具条） ---------------- */

QWidget#TitleBar {
    background-color: #F3F3F3;
    border: none;
}

QWidget#TitleBar QLabel#TitleLabel {
    color: #6A6A6E;
    padding-left: 8px;
    font-size: 12px;
}

QWidget#TitleBar QToolButton {
    background: transparent;
    border: none;
    color: #24292E;
    padding: 0 8px;
}

QWidget#TitleBar QToolButton:hover {
    background-color: #E4E4E6;
}

QWidget#TitleBar QToolButton:pressed {
    background-color: #DADADD;
}

QWidget#TitleBar QToolButton:checked {
    background-color: #F0E4BF;
    color: #8A6D1B;
}

QWidget#TitleBar QToolButton#TitleCloseBtn:hover {
    background-color: #C42B1C;
    color: #FFFFFF;
}

/* 菜单项按钮不画下拉倒三角（VSCode 菜单栏同款纯文字） */
QWidget#TitleBar QToolButton#TitleMenuBtn::menu-indicator {
    image: none;
    width: 0;
    height: 0;
    subcontrol-position: right center;
}

/* ---------------- 标题栏下拉菜单（VSCode 式紧凑菜单） ---------------- */

QMenu {
    background-color: #FFFFFF;
    border: 1px solid #C9C9CD;
    border-radius: 6px;
    padding: 4px 0;
}

QMenu::item {
    padding: 4px 4px 4px 4px;   /* 左侧不再预留图标/勾选列空白 */
    color: #24292E;
    border-radius: 4px;
    margin: 0 4px;
}

QMenu::item:selected {
    background-color: #CDE8FF;
    color: #1F1F1F;
}

QMenu::item:disabled {
    color: #9A9A9E;
}

QMenu::separator {
    height: 1px;
    background: #DCDCDE;
    margin: 4px 8px;
}

QMenu::right-arrow, QMenu::arrow {
    width: 12px;
    height: 12px;
}

/* ---------------- 公共无边框对话框（关于等；标题栏复用 #TitleBar 规则组） ---------------- */

QDialog#FramelessDialog {
    background-color: #FFFFFF;
    border: 1px solid #C9C9CD;
}
