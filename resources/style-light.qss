/* Xterm 亮色主题 —— 与深色版同一结构，仅换色板 */

* {
    color: #24292E;
    /* 选区色不硬编码：唯一由 ThemeManager override 的 selection-background-color: %9 注入，
       9 套主题各自的 selectionBg 生效（硬编码只适配 dark/light，第三方主题会失效） */
}

QMainWindow, QWidget#centralwidget {
    background-color: #F3F3F3;
}

/* ---------------- 面板容器 ---------------- */

/* 高级参数行：与命令栏同款毛玻璃浮层（无边框线半透明底，panelBg 抬档+alpha 200；
   兜底值按 thememanager 的 darker(104)+alpha200 公式预计算，运行时被逐主题 override 覆盖） */
QFrame#advancedBar {
    background-color: rgba(245, 245, 245, 200);
    border: none;
    border-radius: 8px;
}

/* 参数栏已整体嵌入标题栏（用户定稿 2026-11-15）：透明融入标题栏，不再是独立卡片，
   底色由 #TitleBar 的 statusBarBg 承载 */
QFrame#connectionBar {
    background: transparent;
    border: none;
}

/* 参数栏控件随标题栏加高（用户定稿 2026-11-15 回调 40px 栏）恢复自然形态：
   30px 栏时代曾在此硬钳 padding/min-height 到 22px，但 Qt 对超紧凑盒子的文字垂直
   居中计算不可靠（combo/button 文字贴底被裁），现由 C++ 侧统一 setFixedHeight(28)
   并走全局样式；editable combo 的内嵌输入框由全局 QComboBox QLineEdit 规则豁免 */

/* 终端是窗口主体（Termius 式）：不再做独立卡片，底色即终端画布色，
   命令栏等浮层直接盖在上面 */
QFrame#terminalPanel {
    background-color: #FFFFFF; /* = terminalBg（light） */
    border: none;
    border-radius: 0;
}

QLabel {
    background: transparent;
    color: #5A5A5E;
}

/* ---------------- 输入类控件 ---------------- */

/* 圆角基准统一为 8px（用户定稿 2026-11-15 十进制调整：10px 试后回调）：与卡片/浮层
   （advancedBar/CommandBar）同源，也与标题栏按钮 hover 圆角块同款；拼合控件单侧
   0 与行内小元素（item/crumb 3px、进度条 2px）除外 */

QComboBox, QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #C9C9CD;
    border-radius: 8px;
    padding: 3px 8px;
    min-height: 20px;
}
QComboBox:hover, QLineEdit:hover {
    background-color: #F6F6F8;
    border-color: #AFAFB5;
}
QComboBox:focus, QLineEdit:focus {
    border-color: #007ACC;
    background-color: #FFFFFF;
}
QComboBox:disabled, QLineEdit:disabled {
    color: #9A9A9E;
    background-color: #F0F0F2;
    border-color: #DCDCDE;
}
QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: center right;
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    image: url(:/icons/light/down.png);
    width: 12px;
    height: 12px;
}
/* 字号等数字输入：与 QLineEdit 同款（浅色主题保持一致观感） */
QSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #C9C9CD;
    border-radius: 8px;
    padding: 3px 8px;
    min-height: 20px;
}
QSpinBox:hover {
    background-color: #F6F6F8;
    border-color: #AFAFB5;
}
QSpinBox:focus {
    border-color: #007ACC;
}
QSpinBox:disabled {
    color: #9A9A9E;
    background-color: #F0F0F2;
    border-color: #DCDCDE;
}
QSpinBox::up-button, QSpinBox::down-button {
    subcontrol-origin: border;
    border: none;
    width: 20px;
    background-color: transparent;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #F6F6F8;
}
QSpinBox::up-arrow {
    image: url(:/icons/light/up.png);
    width: 12px;
    height: 12px;
}
QSpinBox::down-arrow {
    image: url(:/icons/light/down.png);
    width: 12px;
    height: 12px;
}
QComboBox#baudCombo {
    /* min/max-height 30px 已删（2026-11-15 参数栏嵌入标题栏）：QSS polish 会覆写
       C++ setFixedHeight(28)，高度交还 fixedHeight；纵向 padding 必须保持与全局一致
       的 3px——为 0 时 min-height(20)+0+border(2) 的 hint 仅 22px，combo 在行内矮一截 */
    padding: 3px 2px 3px 8px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-right: none;
}
QToolButton#settingsBtn {
    background-color: #FFFFFF;
    border: 1px solid #C9C9CD;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    padding: 0;
    margin: 0;
    min-width: 30px;
    max-width: 30px;
    /* min/max-height 30px 已删（同 baudCombo，避免覆写 fixedHeight(28)） */
}
QToolButton#settingsBtn:hover {
    background-color: #F6F6F8;
    border-color: #AFAFB5;
}
QToolButton#settingsBtn:pressed {
    background-color: #E8E8EC;
}

QLineEdit#passwordEdit {
    /* min/max-height 30px 已删（同 baudCombo）；padding 行已删——纵向留 0 会把
       min-height(20)+border(2) 的 hint 压到 22px 矮于行内其他控件，用全局 3px 8px */
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-right: none;
}
QToolButton#pwToggleBtn {
    background-color: #FFFFFF;
    border: 1px solid #C9C9CD;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    padding: 0;
    margin: 0;
    min-width: 30px;
    max-width: 30px;
    /* min/max-height 30px 已删（同 baudCombo，避免覆写 fixedHeight(28)） */
}
QToolButton#pwToggleBtn:hover {
    background-color: #F6F6F8;
    border-color: #AFAFB5;
}
QToolButton#pwToggleBtn:pressed {
    background-color: #E8E8EC;
}
QComboBox {
    combobox-popup: 0;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #1F1F1F;
    border: 1px solid #C9C9CD;
    /* 选区色同上：交给 override 按主题注入 */
    outline: none;
}
QComboBox QLineEdit {
    background: transparent;
    border: none;
    padding: 0;
    min-height: 0;
}
QComboBox#sshPortCombo {
    padding: 0;
}
QComboBox#sshPortCombo QLineEdit {
    padding: 0 0 0 8px;
    margin: 0;
}
QComboBox#sshPortCombo::drop-down {
    subcontrol-origin: border;
    subcontrol-position: center right;
    width: 16px;
    border: none;
}

/* ---------------- 多行文本（MCP 提示词 / 命令输出） ---------------- */

QPlainTextEdit, QTextEdit, QTextBrowser {
    background-color: #FBFBFC;
    color: #24292E;
    border: 1px solid #DCDCDE;
    border-radius: 8px;
}
QPlainTextEdit:focus, QTextEdit:focus, QTextBrowser:focus {
    border-color: #007ACC;
}

/* ---------------- 按钮 ---------------- */

QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #C9C9CD;
    border-radius: 8px;
    padding: 5px 14px;
    min-height: 18px;
}
QPushButton:hover {
    background-color: #F0F0F3;
    border-color: #A8A8AE;
}
QPushButton:pressed {
    background-color: #E8E8EC;
}
QPushButton:disabled {
    color: #9A9A9E;
    background-color: #F2F2F4;
    border-color: #DCDCDE;
}

QPushButton#connectBtn {
    background-color: #2EA043;
    border: 1px solid #2C9A40;
    color: #FFFFFF;
    font-weight: 600;
    min-height: 0px;   /* 必须显式压掉全局 18px：否则 hint = 18+padding(5*2)+border(2) = 30px
                          经 polish 压过 setFixedHeight(28)，按钮超高 1px 底部下溢——断开态
                          透明底只剩 1px 边框时截断最明显；纵向 padding 同全局 3px 语义 */
    padding: 3px 14px;
}
QPushButton#connectBtn:hover {
    background-color: #33B349;
    border-color: #36B84D;
}
QPushButton#connectBtn:pressed {
    background-color: #28913C;
}
QPushButton#connectBtn:disabled {
    background-color: #B9D8C0;
    border-color: #B9D8C0;
    color: #F0F6F1;
}

QPushButton#connectBtn[connected="true"] {
    background-color: transparent;
    border: 1px solid #E0A2A2;
    color: #D0453B;
}
QPushButton#connectBtn[connected="true"]:hover {
    background-color: #FBEDED;
    border-color: #E07B7B;
}
QPushButton#connectBtn[connected="true"]:pressed {
    background-color: #F5E2E2;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 3px;
}
QToolButton:hover {
    background-color: #ECECEF;
    border-color: #C9C9CD;
}
QToolButton:pressed {
    background-color: #E2E2E6;
}
QToolButton:checked {
    background-color: #CDE4FB;
    border-color: #7FB6E8;
}
QToolButton:disabled {
    color: #B0B0B4;
}

/* 侧边栏三页签（命令/主题/MCP，cbTab 动态属性定位，用户定稿 2026-11-16）：
   选中态与标题栏收放按钮 hover 同款——圆角色块、无边框线；
   全局 checked 的蓝底蓝边框不再适用（只留给查找框正则切换钮）；
   实际色值由 thememanager 动态 override（%35）按主题派生接管——暗色=buttonHoverBg、
   亮色=panelBg.darker(112)（buttonHoverBg 亮色系与浮层底撞色，选中态隐形）；
   此处为基准主题兜底值（亮色基准 GitHub Light 的 panelBg.darker(112)） */
CommandBar QToolButton[cbTab=true],
CommandBar QToolButton[cbTab=true]:hover,
CommandBar QToolButton[cbTab=true]:checked {
    border: none;
}
CommandBar QToolButton[cbTab=true]:hover,
CommandBar QToolButton[cbTab=true]:checked {
    background-color: #DCDDDF;
}

QToolButton#paneTool {
    background-color: #FFFFFF;
    border: 1px solid #C9C9CD;
    border-radius: 8px;
    padding: 2px 6px;
    color: #1F1F1F;
}
QToolButton#paneTool:hover {
    background-color: #F0F0F3;
    border-color: #A8A8AE;
}
QToolButton#paneTool:pressed {
    background-color: #E8E8EC;
}
QToolButton#paneTool:disabled {
    color: #9A9A9E;
    background-color: #F2F2F4;
    border-color: #DCDCDE;
}

QFrame#pathBar {
    background-color: #FFFFFF;
    border: 1px solid #C9C9CD;
    border-radius: 4px;
}
QFrame#pathBar QScrollArea, QFrame#pathBar QWidget#pathCrumbs {
    background: transparent;
    border: none;
}
QFrame#pathBar QLineEdit#pathEdit {
    border: none;
    background: transparent;
    min-height: 0;
    padding: 0 6px;
}
QToolButton#pathCrumb, QToolButton#pathEditBtn {
    background: transparent;
    border: none;
    border-radius: 3px;
    padding: 1px 4px;
    color: #1F1F1F;
}
QToolButton#pathCrumb {
    padding: 1px 0px;
}
QToolButton#pathCrumb:hover, QToolButton#pathEditBtn:hover {
    background-color: #E8E8EC;
}
QLabel#pathSep {
    color: #8A8A90;
    padding: 0 1px;
    background: transparent;
}

/* 模式切换：当前在哪个终端的主入口，带文字，做出实体按钮感 */
QToolButton#modeBtn, QToolButton#mcpBtn {
    background-color: #FFFFFF;
    border: 1px solid #C9C9CD;
    border-radius: 8px;
    padding: 4px 8px;
    font-weight: 600;
}
QToolButton#modeBtn:hover, QToolButton#mcpBtn:hover {
    background-color: #F0F0F3;
    border-color: #A8A8AE;
}
QToolButton#modeBtn:pressed, QToolButton#mcpBtn:pressed {
    background-color: #E8E8EC;
}

/* 私钥浏览：与 QLineEdit 同一口径，读作输入框的附属按钮 */
QToolButton#keyBrowseBtn {
    background-color: #FFFFFF;
    border: 1px solid #C9C9CD;
    border-radius: 8px;
    padding: 0;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
}
QToolButton#keyBrowseBtn:hover {
    background-color: #F0F0F3;
    border-color: #A8A8AE;
}
QToolButton#keyBrowseBtn:pressed {
    background-color: #E8E8EC;
}
QToolButton#keyBrowseBtn:disabled {
    background-color: #F2F2F4;
    border-color: #DCDCDE;
    color: #B0B0B4;
}

/* 模式页容器：让面板底色透出来，切页时不出现色块 */
QStackedWidget {
    background: transparent;
    border: none;
}

/* ---------------- 列表 ---------------- */

QListWidget {
    background-color: #FBFBFC;
    alternate-background-color: #F3F3F5;
    border: 1px solid #DCDCDE;
    border-radius: 4px;
    outline: none;
}
QListWidget::item {
    padding: 2px;
    border-radius: 3px;
}
QListWidget::item:hover {
    background-color: #F0F0F3;
}
QListWidget::item:selected {
    background-color: #D6E9FF;
    color: #1F1F1F;
}

/* ---------------- 对话框与树/表格（文件管理器 / 传输队列 / 消息框） ---------------- */

QDialog {
    background-color: #F3F3F3;
}

QTreeWidget, QTreeView, QTableWidget, QTableView {
    background-color: #FBFBFC;
    alternate-background-color: #F3F3F5;
    border: 1px solid #DCDCDE;
    border-radius: 4px;
    outline: none;
    gridline-color: #E8E8EA;
}
QTreeView::item, QTreeWidget::item, QTableView::item, QTableWidget::item {
    padding: 2px 1px;
    border-radius: 2px;
}
QTreeView::item:hover, QTreeWidget::item:hover,
QTableView::item:hover, QTableWidget::item:hover {
    background-color: #F0F0F3;
}
QTreeView::item:selected, QTreeWidget::item:selected,
QTableView::item:selected, QTableWidget::item:selected {
    background-color: #D6E9FF;
    color: #1F1F1F;
}
QTreeView::branch {
    background-color: transparent;
}

QHeaderView::section {
    background-color: #EDEDEF;
    color: #3C4045;
    border: none;
    border-right: 1px solid #DCDCDE;
    border-bottom: 1px solid #DCDCDE;
    padding: 4px 8px;
}
QTableCornerButton::section {
    background-color: #EDEDEF;
    border: none;
}

/* Termius 式窄进度条：细条无边框，进度文字由表格行/底栏文字承担，条内不嵌文字 */
QProgressBar {
    background-color: #FFFFFF;
    border: none;
    border-radius: 2px;
    min-height: 5px;
    max-height: 5px;
}
QProgressBar::chunk {
    background-color: #007ACC;
    border-radius: 2px;
}

QSplitter::handle {
    background-color: #DCDCDE;
}
QSplitter::handle:hover {
    background-color: #007ACC;
}

/* ---------------- 滚动区与滚动条 ---------------- */

QScrollArea {
    background: transparent;
    border: none;
}
QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* Termius 式滚动条：5px 细轨道（用户定稿：在 6px 基础上再减 1/10），滑块与轨道同宽
   全幅（命中即整条）；flash 由 ScrollFlash 切换——待机滑块透明且鼠标穿透，仅滚轮/
   鼠标移入时浮现完整竖条，停止 2s 后隐去；悬停滑块变色（主题注入）即吸附提示 */
QScrollBar:vertical {
    background: transparent;
    width: 5px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #A9A9B0;
    min-height: 48px; /* 长度下限：内容再多也不无限压缩 */
    max-height: 100px; /* 长度上限：内容略多时也不占满整条 */
}
QScrollBar:horizontal {
    background: transparent;
    height: 5px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #A9A9B0;
    min-width: 48px;
    max-width: 100px;
}
QScrollBar[flash="true"]:vertical,
QScrollBar[flash="true"]:horizontal {
    background: rgba(0, 0, 0, 13); /* 5% 黑叠加（QSS rgba 整数 alpha，浮点丢规则）；Termius 由主题注入实色 */
}
QScrollBar[flash="false"]::handle:vertical,
QScrollBar[flash="false"]::handle:horizontal {
    background: transparent;
}
QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #8E8E96;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ---------------- 状态栏 ---------------- */

QStatusBar {
    background-color: #F3F3F3;
    border-top: 1px solid #007ACC;
    color: #6A6A6E;
}
QStatusBar QLabel {
    color: #6A6A6E;
    padding: 0 2px;
}

/* ---------------- 提示气泡 ---------------- */

QToolTip {
    background-color: #FFFFFF;
    color: #24292E;
    border: 1px solid #C9C9CD;
    padding: 5px 8px;
    border-radius: 3px;
}

/* ---------------- 自定义标题栏（无边框窗口，VSCode 式工具条） ---------------- */

QWidget#TitleBar {
    background-color: #F3F3F3;
    border: none;
}

QWidget#TitleBar QLabel#TitleIcon {
    padding-top: 4px; /* 与菜单文字/系统按钮同幅下移，视觉对齐 */
}

QWidget#TitleBar QLabel#TitleLabel {
    color: #6A6A6E;
    padding-left: 8px;
    padding-top: 4px; /* 与菜单按钮文字同幅下移，视觉基线对齐 */
    font-size: 12px;
}

/* 平铺样式只套标题栏自有按钮（按 objectName 收窄，不可宽泛匹配 #TitleBar QToolButton）：
   参数栏嵌入标题栏后（用户定稿 2026-11-15），宽泛规则的特异性会压过
   QToolButton#settingsBtn 等 id 规则与 :checked 选中高亮，把参数栏按钮的
   实体底色/选中态吃掉 */
QWidget#TitleBar QToolButton#TitleStatusBtn,
QWidget#TitleBar QToolButton#TitleSidebarBtn,
QWidget#TitleBar QToolButton#TitleMinBtn,
QWidget#TitleBar QToolButton#TitleMaxBtn,
QWidget#TitleBar QToolButton#TitleCloseBtn {
    background: transparent;
    border: none;
    border-radius: 8px; /* hover/pressed 圆润圆角块（2026-11-14 五轮定 10px，2026-11-15 全局统一 8px 试定） */
    color: #24292E;
    padding: 4px 8px 0; /* 顶部 padding 把文字/图标往下压一点，纠正垂直居中的视觉偏上 */
}

/* 图标按钮免 padding：28×28 正方形内 padding 会把 20px 图标挤裁；图标居中即可 */
QWidget#TitleBar QToolButton#TitleStatusBtn,
QWidget#TitleBar QToolButton#TitleSidebarBtn {
    padding: 0;
}

/* hover/pressed 不含 close：close 键红底是 Win 惯例，由下方专属规则承担 */
QWidget#TitleBar QToolButton#TitleStatusBtn:hover,
QWidget#TitleBar QToolButton#TitleSidebarBtn:hover,
QWidget#TitleBar QToolButton#TitleMinBtn:hover,
QWidget#TitleBar QToolButton#TitleMaxBtn:hover {
    background-color: #E4E4E6;
}

QWidget#TitleBar QToolButton#TitleStatusBtn:pressed,
QWidget#TitleBar QToolButton#TitleSidebarBtn:pressed,
QWidget#TitleBar QToolButton#TitleMinBtn:pressed,
QWidget#TitleBar QToolButton#TitleMaxBtn:pressed {
    background-color: #DADADD;
}

QWidget#TitleBar QToolButton#TitleCloseBtn:hover {
    background-color: #C42B1C;
    color: #FFFFFF;
}

/* ---------------- 标题栏下拉菜单（VSCode 式紧凑菜单） ---------------- */

QMenu {
    background-color: #FFFFFF;
    border: 1px solid #C9C9CD;
    border-radius: 6px;
    padding: 4px 0;
}

QMenu::item {
    padding: 4px 4px 4px 4px;   /* 左侧不再预留图标/勾选列空白 */
    color: #24292E;
    border-radius: 4px;
    margin: 0 4px;
}

QMenu::item:selected {
    background-color: #CDE8FF;
    color: #1F1F1F;
}

QMenu::item:disabled {
    color: #9A9A9E;
}

QMenu::separator {
    height: 1px;
    background: #DCDCDE;
    margin: 4px 8px;
}

QMenu::right-arrow, QMenu::arrow {
    width: 12px;
    height: 12px;
}

/* ---------------- 公共无边框对话框（关于等；标题栏复用 #TitleBar 规则组） ---------------- */

QDialog#FramelessDialog {
    background-color: #FFFFFF;
    border: 1px solid #C9C9CD;
}

/* 弹窗紧凑栏（36px，用户反馈 2026-11-18：主窗口 50px 承载参数栏，弹窗无需同高）：
   主窗口栏里标题的 padding-top 4px 是与菜单行文字基线对齐用的，矮栏里会显得
   偏下，归零交给布局垂直居中。选择器加 #FramelessDialog 前缀提高特异性，不回透主窗口 */
QDialog#FramelessDialog QWidget#TitleBar QLabel#TitleLabel {
    padding-top: 0px;
}
